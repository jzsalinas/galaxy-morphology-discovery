</tr>
<tr>
<td><p><code class="docutils literal">gaia_astrometric_excess_noise</code></p></td>
<td><p>float32</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> astrometric excess noise</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_astrometric_excess_noise_sig</code></p></td>
<td><p>float32</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> astrometric excess noise uncertainty</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_astrometric_n_obs_al</code></p></td>
<td><p>int16</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> number of astrometric observations along scan direction</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_astrometric_n_good_obs_al</code></p></td>
<td><p>int16</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> number of good astrometric observations along scan direction</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_astrometric_weight_al</code></p></td>
<td><p>float32</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> astrometric weight along scan direction</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_duplicated_source</code></p></td>
<td><p>boolean</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> duplicated source flag</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_a_g_val</code></p></td>
<td><p>float32</p></td>
<td><p>mag</p></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> line-of-sight extinction in the G band</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_e_bp_min_rp_val</code></p></td>
<td><p>float32</p></td>
<td><p>mag</p></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> line-of-sight reddening E(BP-RP)</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_phot_bp_rp_excess_factor</code></p></td>
<td><p>float32</p></td>
<td></td>
