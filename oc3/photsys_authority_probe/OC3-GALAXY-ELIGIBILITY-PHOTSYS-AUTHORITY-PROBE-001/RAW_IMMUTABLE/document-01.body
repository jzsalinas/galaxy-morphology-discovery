<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> BP signal-to-noise</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_phot_bp_n_obs</code></p></td>
<td><p>int16</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> BP number of observations</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_phot_rp_mean_mag</code></p></td>
<td><p>float32</p></td>
<td><p>mag</p></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> RP magnitude</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_phot_rp_mean_flux_over_error</code></p></td>
<td><p>float32</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> RP signal-to-noise</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_phot_rp_n_obs</code></p></td>
<td><p>int16</p></td>
<td></td>
<td><p><a class="reference external" href="https://gea.esac.esa.int/archive/documentation//GDR2/Gaia_archive/chap_datamodel/sec_dm_main_tables/ssec_dm_gaia_source.html">Gaia</a> RP number of observations</p></td>
</tr>
<tr>
<td><p><code class="docutils literal">gaia_phot_variable_flag</code></p></td>
<td><p>boolean</p></td>
