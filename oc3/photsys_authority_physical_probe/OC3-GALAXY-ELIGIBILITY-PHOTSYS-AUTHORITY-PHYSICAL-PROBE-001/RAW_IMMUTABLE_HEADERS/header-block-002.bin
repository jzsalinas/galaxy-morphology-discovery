XTENSION= 'BINTABLE'           / binary table extension                         BITPIX  =                    8 / 8-bit bytes                                    NAXIS   =                    2 / 2-dimensional binary table                     NAXIS1  =                   79 / width of table in bytes                        NAXIS2  =               662174 / number of rows in table                        PCOUNT  =                    0 / size of special data area                      GCOUNT  =                    1 / one data group (required keyword)              TFIELDS =                   13 / number of fields in each row                   TTYPE1  = 'BRICKNAME'          / label for field   1                            TFORM1  = '8A      '           / data format of field: ASCII Character          TTYPE2  = 'BRICKID '           / label for field   2                            TFORM2  = 'J       '           / data format of field: 4-byte INTEGER           TTYPE3  = 'BRICKQ  '           / label for field   3                            TFORM3  = 'I       '           / data format of field: 2-byte INTEGER           TTYPE4  = 'BRICKROW'           / label for field   4                            TFORM4  = 'J       '           / data format of field: 4-byte INTEGER           TTYPE5  = 'BRICKCOL'           / label for field   5                            TFORM5  = 'J       '           / data format of field: 4-byte INTEGER           TTYPE6  = 'RA      '           / label for field   6                            TFORM6  = 'D       '           / data format of field: 8-byte DOUBLE            TTYPE7  = 'DEC     '           / label for field   7                            TFORM7  = 'D       '           / data format of field: 8-byte DOUBLE            TTYPE8  = 'RA1     '           / label for field   8                            TFORM8  = 'D       '           / data format of field: 8-byte DOUBLE            TTYPE9  = 'RA2     '           / label for field   9                            TFORM9  = 'D       '           / data format of field: 8-byte DOUBLE            TTYPE10 = 'DEC1    '           / label for field  10                            TFORM10 = 'D       '           / data format of field: 8-byte DOUBLE            TTYPE11 = 'DEC2    '           / label for field  11                            TFORM11 = 'D       '           / data format of field: 8-byte DOUBLE            TTYPE12 = 'PHOTSYS '           / label for field  12                            TFORM12 = '1A      '           / data format of field: ASCII Character          TTYPE13 = 'AREA_PER_BRICK'     / label for field  13                            TFORM13 = 'D       '           / data format of field: 8-byte DOUBLE            EXTNAME = 'BRICKRANDOMS'       / name of this binary table extension            COMMENT  *** End of mandatory fields ***                                        